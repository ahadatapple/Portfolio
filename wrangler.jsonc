// Cloudflare Workers static-assets config. The site is fully static: Workers
// serves the files in dist/ directly, with no Worker code. `_headers` in
// public/ is copied into dist/ and applied to every response.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    // /projects/gomoku serves dist/projects/gomoku.html
    "html_handling": "drop-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}

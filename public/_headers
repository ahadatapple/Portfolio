# Cloudflare Pages (and Netlify) response headers.
# HTML is left at the host default (revalidate on every visit), so edits
# appear as soon as a deploy finishes.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Fingerprinted build output: the file name changes when the content does.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Preview images and icons: regenerated on each deploy, rarely changed.
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Résumés change, and a recruiter should never get an old one.
/resume.pdf
  Cache-Control: public, max-age=300, must-revalidate
  Content-Disposition: inline; filename="Ahad_Rahman_Resume.pdf"
/resume-ee.pdf
  Cache-Control: public, max-age=300, must-revalidate
  Content-Disposition: inline; filename="Ahad_Rahman_Resume_EE.pdf"

---
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/site';

const path = Astro.url.pathname;
const onHome = path === '/' || path === '/index.html';
---

<header class="site-header">
  <div class="container bar">
    {
      onHome ? (
        <span class="wordmark" aria-hidden="true">{profile.name}</span>
      ) : (
        <a class="wordmark" href="/">{profile.name}</a>
      )
    }
    <nav aria-label="Primary">
      <ul>
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href={profile.resume}>Résumé</a></li>
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.5rem;
  }

  .wordmark {
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 0.9375rem;
    color: var(--muted);
    text-decoration: none;
    padding-block: var(--space-2);
  }

  nav a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  @media (max-width: 30rem) {
    .wordmark {
      display: none;
    }

    nav {
      margin-right: auto;
    }
  }
</style>
